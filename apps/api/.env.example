ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5173

# AI providers — server-side only, never sent to the client
GROQ_API_KEY=
ELEVEN_LABS_API_KEY=
